---
import Layout from "@/layouts/Layout.astro";
import { assignedTrainee } from "@/lib/access";
const access = Astro.locals.access;
const trainee = assignedTrainee(access, Astro.params.traineeId);
const unavailable = access.kind === "unavailable";
Astro.response.status = unavailable ? 503 : trainee ? 200 : 404;
---

<Layout title="Karta podopiecznego · GymPlanner" lang="pl">
  <main class="min-h-screen bg-slate-950 px-5 py-12 text-slate-100">
    <div class="mx-auto max-w-3xl">
      <a
        href="/dashboard"
        class="rounded text-lime-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        ← Wróć do panelu
      </a>
      <section class="mt-8 rounded-2xl border border-slate-700 bg-slate-900 p-6 sm:p-8">
        {trainee ? (
          <>
            <p class="mb-3 text-sm text-lime-300">Podopieczny</p>
            <h1 class="text-3xl font-semibold break-words">{trainee.display_name}</h1>
            <p class="mt-3 break-words text-slate-400">{trainee.identification_label}</p>
            <a
              href={`/dashboard/training?trainee=${trainee.id}`}
              class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-lime-300 px-5 py-3 font-medium text-slate-950 hover:bg-lime-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime-300"
            >
              Plany i wyniki podopiecznego
            </a>
          </>
        ) : unavailable ? (
          <>
            <h1 class="text-3xl font-semibold">Panel jest chwilowo niedostępny</h1>
            <p class="mt-4 text-slate-300">Nie udało się odczytać danych. Spróbuj ponownie za chwilę.</p>
          </>
        ) : (
          <>
            <h1 class="text-3xl font-semibold">Nie znaleziono strony</h1>
            <p class="mt-4 text-slate-300">Wróć do swojego panelu.</p>
          </>
        )}
      </section>
    </div>
  </main>
</Layout>
