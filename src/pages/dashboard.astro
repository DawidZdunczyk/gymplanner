---
import Layout from "@/layouts/Layout.astro";
import TraineeList from "@/components/trainees/TraineeList.astro";
const access = Astro.locals.access;
if (access.kind === "unavailable") Astro.response.status = 503;
---

<Layout title="Twój panel · GymPlanner" lang="pl">
  <main class="min-h-screen bg-slate-950 px-5 py-8 text-slate-100 sm:px-8 sm:py-12">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 flex flex-wrap items-center justify-between gap-4 border-b border-slate-700 pb-6">
        <a
          href="/dashboard"
          class="rounded text-xl font-semibold tracking-tight focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime-300"
        >
          GymPlanner<span class="text-lime-300">.</span>
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-slate-600 px-4 py-2 text-sm hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime-300"
          >
            Wyloguj się
          </button>
        </form>
      </header>
      {access.kind === "trainer" || access.kind === "trainee" ? (
        <>
          <p class="mb-3 text-sm font-medium text-lime-300">
            {access.kind === "trainer" ? "Panel trenera" : "Panel podopiecznego"}
          </p>
          <h1 class="text-3xl font-semibold break-words sm:text-4xl">{access.profile.display_name}</h1>
          <p class="mt-2 break-words text-slate-400">{access.profile.identification_label}</p>
          <a
            href="/dashboard/training"
            class="mt-7 inline-flex min-h-11 items-center rounded-lg bg-lime-300 px-5 py-3 font-semibold text-slate-950 hover:bg-lime-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime-300"
          >
            {access.kind === "trainer" ? "Plany i treningi" : "Twoje treningi"} →
          </a>
          {access.kind === "trainer" ? (
            <section class="mt-12" aria-labelledby="trainees-title">
              <h2 id="trainees-title" class="mb-5 text-xl font-semibold">
                Twoi podopieczni
              </h2>
              <TraineeList trainees={access.trainees} />
            </section>
          ) : (
            <section class="mt-12 rounded-2xl border border-slate-700 bg-slate-900 p-6" aria-labelledby="trainer-title">
              <h2 id="trainer-title" class="text-xl font-semibold">
                Twój trener
              </h2>
              {access.trainer ? (
                <>
                  <p class="mt-4 text-lg break-words">{access.trainer.display_name}</p>
                  <p class="mt-1 break-words text-slate-400">{access.trainer.identification_label}</p>
                </>
              ) : (
                <p class="mt-4 text-slate-300">Nie masz jeszcze przypisanego trenera.</p>
              )}
            </section>
          )}
        </>
      ) : access.kind === "unavailable" ? (
        <section>
          <h1 class="text-3xl font-semibold">Panel jest chwilowo niedostępny</h1>
          <p class="mt-4 text-slate-300">Nie udało się odczytać danych. Spróbuj ponownie za chwilę.</p>
          <a
            href="/dashboard"
            class="mt-6 inline-block rounded text-lime-300 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            Spróbuj ponownie
          </a>
        </section>
      ) : (
        <section>
          <h1 class="text-3xl font-semibold">Konto oczekuje na konfigurację</h1>
          <p class="mt-4 text-slate-300">Twoje konto jest aktywne. Operator przygotuje Twój profil i dostęp.</p>
        </section>
      )}
    </div>
  </main>
</Layout>
