{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymplanner-local",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "gymplanner-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ALLOW_SIGNUP": false },
    },
    "production": {
      "name": "gymplanner",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ALLOW_SIGNUP": false },
    },
  },
}
